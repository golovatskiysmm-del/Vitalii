# ============================================================
# Instagram Carousel Studio - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# -------------------------------------------------------
# DATABASE
# For LOCAL development with SQLite:
#   1. Copy prisma/schema.sqlite.prisma to prisma/schema.prisma
#   2. Set: DATABASE_URL="file:./dev.db"
#   3. Run: npm run db:push
#
# For VERCEL production with Postgres:
#   1. Add Vercel Postgres from your Vercel dashboard
#   2. Vercel auto-sets DATABASE_URL and DIRECT_URL
# -------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# -------------------------------------------------------
# AI APIs (REQUIRED)
# -------------------------------------------------------

# Anthropic Claude - for content analysis and text generation
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI - for DALL-E 3 image generation
# Get from: https://platform.openai.com/
OPENAI_API_KEY="sk-..."

# Replicate - for Flux image generation (alternative to DALL-E)
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN="r8_..."

# -------------------------------------------------------
# INSTAGRAM GRAPH API (for posting)
# Get from: https://developers.facebook.com/
# Requires Instagram Business/Creator account + Facebook Page
# -------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN="EAABm..."
INSTAGRAM_BUSINESS_ACCOUNT_ID="17841400..."

# -------------------------------------------------------
# VERCEL BLOB (for image storage on Vercel)
# Auto-added by Vercel when you add Blob storage
# -------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# -------------------------------------------------------
# APP
# -------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
