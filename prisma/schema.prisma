generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Avatar {
  id        String   @id @default(uuid())
  name      String
  imagePath String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model InstagramAccount {
  id          String   @id @default(uuid())
  username    String
  accessToken String
  accountId   String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AnalyzedPost {
  id           String     @id @default(uuid())
  instagramUrl String
  shortcode    String
  caption      String?
  slides       String
  status       String     @default("analyzed")
  createdAt    DateTime   @default(now())
  carousels    Carousel[]
}

model Carousel {
  id              String        @id @default(uuid())
  analyzedPostId  String?
  analyzedPost    AnalyzedPost? @relation(fields: [analyzedPostId], references: [id])
  title           String?
  caption         String
  slides          String
  status          String        @default("draft")
  scheduledAt     DateTime?
  postedAt        DateTime?
  instagramPostId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
